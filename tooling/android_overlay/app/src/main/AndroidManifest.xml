<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name="${applicationName}"
        android:label="Kumone"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchFrost"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
        </activity>

        <activity android:name=".FrostActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity=""
            android:theme="@style/LaunchFrost"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
        </activity>
        <activity android:name=".CrystalActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity=""
            android:theme="@style/LaunchCrystal"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
        </activity>
        <activity android:name=".PastelActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity=""
            android:theme="@style/LaunchPastel"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
        </activity>
        <activity android:name=".PinkActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity=""
            android:theme="@style/LaunchPink"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
        </activity>

        <activity android:name=".EmeraldActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity="" android:theme="@style/LaunchEmerald"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
        </activity>
        <activity android:name=".ClearblueActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity="" android:theme="@style/LaunchClearblue"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
        </activity>
        <activity android:name=".CrystalblueActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity="" android:theme="@style/LaunchCrystalblue"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
        </activity>

        <activity android:name=".RedpinkActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity="" android:theme="@style/LaunchRedpink"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
        </activity>
        <activity android:name=".ClearredpinkActivity" android:exported="true"
            android:launchMode="singleTop" android:taskAffinity="" android:theme="@style/LaunchClearredpink"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
        </activity>
<!-- Stable alias names: keep these across upgrades so Android preserves selection. -->
        <activity-alias android:name=".IconFrost" android:targetActivity=".FrostActivity"
            android:enabled="true" android:exported="true" android:label="Kumone"
            android:icon="@mipmap/ic_frost" android:roundIcon="@mipmap/ic_frost">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconCrystal" android:targetActivity=".CrystalActivity"
            android:enabled="false" android:exported="true" android:label="Kumone"
            android:icon="@mipmap/ic_crystal" android:roundIcon="@mipmap/ic_crystal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconPastel" android:targetActivity=".PastelActivity"
            android:enabled="false" android:exported="true" android:label="Kumone"
            android:icon="@mipmap/ic_pastel" android:roundIcon="@mipmap/ic_pastel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconPink" android:targetActivity=".PinkActivity"
            android:enabled="false" android:exported="true" android:label="Kumone"
            android:icon="@mipmap/ic_pink" android:roundIcon="@mipmap/ic_pink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".IconEmerald" android:targetActivity=".EmeraldActivity"
            android:enabled="false" android:exported="true" android:label="Kumone"
            android:icon="@mipmap/ic_emerald" android:roundIcon="@mipmap/ic_emerald">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconClearblue" android:targetActivity=".ClearblueActivity"
            android:enabled="false" android:exported="true" android:label="Kumone"
            android:icon="@mipmap/ic_clearblue" android:roundIcon="@mipmap/ic_clearblue">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconCrystalblue" android:targetActivity=".CrystalblueActivity"
            android:enabled="false" android:exported="true" android:label="Kumone"
            android:icon="@mipmap/ic_crystalblue" android:roundIcon="@mipmap/ic_crystalblue">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>

        <activity-alias android:name=".IconRedpink" android:targetActivity=".RedpinkActivity"
            android:enabled="false" android:exported="true" android:label="Kumone"
            android:icon="@mipmap/ic_redpink" android:roundIcon="@mipmap/ic_redpink">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconClearredpink" android:targetActivity=".ClearredpinkActivity"
            android:enabled="false" android:exported="true" android:label="Kumone"
            android:icon="@mipmap/ic_clearredpink" android:roundIcon="@mipmap/ic_clearredpink">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
<service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <meta-data android:name="io.flutter.embedding.android.EnableImpeller" android:value="true" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
